# Sustituir por el dominio real y una ruta de instalación confirmada.
guardian.example.com {
    root * /opt/guardian/site
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Content-Security-Policy "default-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
    file_server
}
