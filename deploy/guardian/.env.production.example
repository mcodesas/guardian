# Copy to /opt/guardian/.env (chmod 600); never commit live values.
# Generate DB password and pepper with: openssl rand -hex 32
GUARDIAN_IMAGE_TAG=REPLACE_WITH_VERIFIED_GIT_SHA
GUARDIAN_DB_PASSWORD=
GUARDIAN_AUTH_PEPPER=

GUARDIAN_SMTP_HOST=
GUARDIAN_SMTP_PORT=587
GUARDIAN_SMTP_USERNAME=
GUARDIAN_SMTP_PASSWORD=
GUARDIAN_SMTP_AUTH=true
GUARDIAN_SMTP_STARTTLS=true
GUARDIAN_MAIL_FROM=

GUARDIAN_FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# Generate with: openssl rand -base64 32
GUARDIAN_PUSH_ENCRYPTION_KEY_BASE64=

# Encryption key for private device-location observations
GUARDIAN_EVIDENCE_KEY_BASE64=
